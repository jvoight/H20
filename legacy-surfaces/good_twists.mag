function d1(r)
  case r:
    when KodairaSymbol("In"): return NumberOfComponents(r);
    when KodairaSymbol("I0*"): return 4;
    when KodairaSymbol("In*"): return 4;
    when KodairaSymbol("II"): return 1;
    when KodairaSymbol("III"): return 2;
    when KodairaSymbol("IV"): return 3;
    when KodairaSymbol("IV*"): return 3;
    when KodairaSymbol("III*"): return 2;
    when KodairaSymbol("II*"): return 1;
    else error "unknown Kodaira symbol";
  end case;
end function;

// how it changes when you twist
function tw_ch(r)
  case r:
    when KodairaSymbol("In"): return 4/NumberOfComponents(r);
    when KodairaSymbol("I0*"): return 1/4;
    when KodairaSymbol("In*"): return (NumberOfComponents(r)-5)/4;
    when KodairaSymbol("II"): return 3;
    when KodairaSymbol("III"): return 1;
    when KodairaSymbol("IV"): return 1/3;
    when KodairaSymbol("IV*"): return 1/3;
    when KodairaSymbol("III*"): return 1;
    when KodairaSymbol("II*"): return 3;
    else error "unknown Kodaira symbol";
  end case;
end function;

// we really only care up to squares, so could leave out the torsion factor
disc := func<e|&*[d1(i[5])^Degree(i[1]): i in LocalInformation(e)]/#TorsionSubgroup(e)^2>;

function twists(e: deg := 2, square_only := true)
  li := LocalInformation(e);
  d0 := disc(e);
  if deg eq 0 then
    return (not square_only or IsSquare(d0) select [e] else []);
  end if;
  nums := [<Numerator(BaseField(e)!Minimum(x[1])),Degree(x[1]),tw_ch(x[5]),x[5]>: x in li];
  Qn := PolynomialRing(Q,[x[2]: x in nums]);
  ms := [x: x in MonomialsOfWeightedDegree(Qn,deg)|IsSquarefree(x) and forall{i: i in [1..#nums]|Degree(x,i) eq 0 or (s[#s] ne "*" where s is Sprintf("%o",nums[i,4]))}];
  tws := [QuadraticTwist(e,&*[nums[i,1]: i in [1..#nums]|Degree(m,i) eq 1]): m in ms|not square_only or IsSquare(d0*&*[nums[i,3]^nums[i,2]: i in [1..#nums]|Degree(m,i) eq 1])];
  return tws;
end function;
