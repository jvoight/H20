// Four candidates, of which three have 0 or 1 starred fibre:
// III*I8I4I2I1 Schutt, #271 (only defined over Q(i))
// I5*I8I2I2I1 Schutt, #184
// I8I4I4I4I2I2 double cover of I4I4I2I2

Qs<s> := FunctionField(Q);
X321 := EllipticCurve([-3*(s-1)^3*(s-4),-2*(s-1)^5*(s+8)]);
bc2 := BaseChange(X321,hom<Qs->Qs|-s^4*(s^2+2*s+5)/(4*(1-2*s))>);
ec2 := MinimalDegreeModel(QuadraticTwist(bc2,s^3+s^2+2*s-2));

leg := EllipticCurve([0,-1-s^2,0,s^2,0]);
ec3 := BaseChange(leg,hom<Qs->Qs|s^2-1>);
ec3p := BaseChange(leg,hom<Qs->Qs|2*s^2-1>);
// it has different twists

ecs_disc32 := [ec2,ec3,ec3p];
