// Discriminant 16
// There are 4 possibilities:
// A3^6 is the universal elliptic curve over X(4)
// A1^4 A7^2 is 2-isogenous to it
// D10 A3A3A1A1 is constructed by Schuett from III I4I3I2
// D7 A7A3A1A0 is 2-isogenous to that.
// Alternatively, we already found D16 A1A1A0A0, so we could have used
// a 2-isogeny from it.
Qs<s> := FunctionField(Q);
// this is in Fisher, https://www.dpmms.cam.ac.uk/~taf1000/papers/vis4.pdf
ec1 := EllipticCurve([0,-r-1,0,r,0]) where r is (1-s^2)^2/(1+s^2)^2;
ec2 := Codomain(TwoIsogeny(ec1![0,0]));


h3 := EllipticCurve([-3*(s-1)*(16*s^3-3*s-1)/4,-(s-1)^2*(64*s^4+32*s^3+6*s^2+5*s+1)/4]);
// base change to make it a bit more obvious
i3 := BaseChange(h3,hom<Qs->Qs|1/s>);
ti3 := BaseChange(i3,hom<Qs->Qs|s+1>);
pec3 := BaseChange(ti3,hom<Qs->Qs|-s^2>);
// now twist to make I6 I0* into I6*
ec3 := QuadraticTwist(pec3,s);
// now we have D10 A3A3A1A1.
tor,torto := TorsionSubgroup(ec3);
t2s := [Codomain(TwoIsogeny(torto(i))): i in tor|Order(i) eq 2];
ec4 := rep{x: x in t2s|<KodairaSymbol("I3*"),1> in KodairaSymbols(x)};

ecs_disc16 := [ec1,ec2,ec3,ec4];
