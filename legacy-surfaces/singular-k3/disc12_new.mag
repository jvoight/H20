// There are essentially five possibilities for discriminant 12:
// I10* I3 I2 I2 I1, Z/2Z
// I6* I6 I2 I2 I2, (Z/2Z)^2
// I1* I12 I2 I2 I1, Z/4Z
// I12 I4 I3 I3 I1 I1, Z/6Z
// I6 I6 I6 I2 I2 I2, Z/6Z + Z/2Z
// The last two come from base changes of I6I3I2I1 and should be isogenous.

// We start with the last two, because of the 6-torsion.
Qs<s> := FunctionField(Q);
// would need to twist by 6 to see the 6-torsion
e := EllipticCurve([-12*s^4+48*s^3-24*s-12,16*s^6-96*s^5+96*s^4+112*s^3+24*s^2+48*s+16]);
// ramified at I6, I2
ec4 := BaseChange(e,hom<Qs->Qs|2*s^2-1/2>); // the correct twist
ec5 := BaseChange(e,hom<Qs->Qs|s^2/(s^2+3*s+3)>); // not the correct twist

// The second one is a base change of the Legendre family, which is I2* I2 I2.
l := EllipticCurve([0,-s-1,0,s,0]);
ec2 := BaseChange(l,hom<Qs->Qs|s^3>);

// For the other two we may have to work harder to write down the surface.
// For the first one, we use a general form of the surface with a D14 fibre
// and a 2-torsion section.

Q6<a,b,c,d,e,f> := FunctionField(Q,6);
Q6t<t> := FunctionField(Q6);
ai := [0,a+b*t+c*t^2+d*t^3,0,e+f*t,0];
ec := EllipticCurve(ai);
// now put 3 orders of vanishing at 0

ai := [0,a+b*t+c*t^2+d*t^3,0,a^2/4+f*t,0];
ec := EllipticCurve(ai);

ai := [0,a+b*t+c*t^2+d*t^3,0,a^2/4+a*b/2*t,0];
ec := EllipticCurve(ai);

ai := [0,a+b*t+(-b^2/(2*a))*t^2+d*t^3,0,a^2/4+a*b/2*t,0];
ec := EllipticCurve(ai);

// We also ended up with an I2 at -a/2b, so let's put a = -2b.
Q2<b,d> := FunctionField(Q,2);
Q2t<t> := FunctionField(Q2);
ai := [0,a+b*t+(-b^2/(2*a))*t^2+d*t^3,0,a^2/4+a*b/2*t,0] where a is -2*b;
ec := EllipticCurve(ai);

// Note that nothing changes if we rescale b and d together, so can put
// d = 1.
Qsu<u> := FunctionField(Qs);

ai := [0,-2*s+s*u+(-s^2/(2*-2*s))*u^2+u^3,0,(-2*s)^2/4+(-2*s)*s/2*u,0];
ec := EllipticCurve(ai);
// We now need to bring two of the I1's to the same point, so that they
// become an I2.  That means putting s = 108 (not 0 which merges too much).
// Not sure how it happened that the two I2's are rational, but I'll take it.
ec1 := BaseChange(ec,hom<Qsu->Qs|hom<Qs->Qs|108>,s>);

// Finally we look at order I1* I12 I2 I2 I1.  In hindsight we could have
// taken this from Schutt, but I did it by hand.
Q5<a,b,c,d,e> := FunctionField(Q,5);
Q5t<t> := FunctionField(Q5);
// a bit of inspired guessing
ai := [1,r,r,0,0] where r is (a+b*t+c*t^2+d*t^3)/(1+e*t);
ec := EllipticCurve(ai);

Q3<a,b,c> := FunctionField(Q,3);
Q3t<t> := FunctionField(Q3);
ai := [1,r,r,0,0] where r is a*(1+b*t)^3/(1+c*t);
ec := EllipticCurve(ai);

// and now we just need to merge two of the I1 fibres, which means we need
// ab^3 - 2ab^2c + abc^2 - 1/108 c^3 = 0.
// It doesn't matter which one we take, up to a change of coordinates on
// the base.

ai := [1,r,r,0,0] where r is 1/16*(1-s/8)^3/(1-3/8*s);
ec := EllipticCurve(ai);
// let's put the distinguished fibres at the usual points.
P1 := ProjectiveSpace(Q,1);
tr := TranslationOfSimplex(P1,[P1(Q)|[8/3],[8],[24]]);
ec5 := BaseChange(ec,hom<Qs->Qs|Evaluate(d[1]/d[2],[s,1])>) where d is DefiningPolynomials(tr);

ecs_disc12 := [ec1,ec2,ec3,ec4,ec5];
