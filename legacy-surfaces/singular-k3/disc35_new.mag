// In discriminant -35 there are two choices:
// E8A6A4 specialize EK 21
// A13A4A1 Schutt, figure 17

Q2<a,b> := FunctionField(Q,2);
Q2t<t> := FunctionField(Q2);
e := (a-b)^2 * (a^2-1);
c := e^2*(1-t) + e^2*a^2*t;
b := e*(1-t) + e*a*b*t;
a := 1+(-a^2+2*a*b-1)*t-(-a^2-b^2+2*a*b)*t^2; // (b^2/c) % (t^3-t^2); 
ai := [0,a,0,2*b*(t^3-t^2),c*(t^3-t^2)^2];
ec := EllipticCurve(ai);
// put b = a^3 for A3 instead of A2

Qs<s> := FunctionField(Q);
Qsu<u> := FunctionField(Qs);
ec := BaseChange(ec,hom<Q2t->Qsu|hom<Q2->Qsu|s,s^3>,u>);
// it looks bad, but luckily this is after E-K made a base change
Qrs<rs> := ext<Qs|Polynomial([-s,0,1])>;
Qrsv<v> := FunctionField(Qrs);
ecr := ChangeRing(BaseChange(ec,hom<Qsu->Qrsv|hom<Qs->Qrsv|rs>,v>),Qsu);
ec1 := BaseChange(ecr,hom<Qsu->Qs|hom<Qs->Qs|1/5>,s>);

ec2 := EllipticCurve([-3*(16*s^8+32*s^7-112*s^3+56*s^2-40*s+25),-2*(-5+4*s-4*s^2+8*s^3+8*s^4)*(8*s^8+16*s^7+112*s^3-56*s^2+40*s-25)]);

ecs_disc35 := [ec1,ec2];
