// lots of possibilities here, even throwing away the ones with two stars:
// A11E7 specialize A9E7 from Elkies-Kumar
// D15A2A1 specialize I9I1* and twist
// D13A5 specialize I9I1* and twist
// D12A3A2A1 Schutt, #203, or twist of D8A7A3A1 (disc 16)
// D10A5A3 Schutt, #192
// D8A5A3A1A1 Schutt, #172
// D6A11A1 Schutt, #151
// A15A2A1 Schutt, fig. 2 on p. 8
// A11A5A2 Schutt, fig. 15 on p. 13
// A11A3A3A1 Schutt, p. 8
// A11A2A2A1A1A1 specialize point of order 3
// A5A5A5A3 specialize point of order 3

// We will get A11E7 by specializing the A9E7 family already in disc20.mag.
Q3<a1,b2,b3> := FunctionField(Q,3);
Q3t<t> := FunctionField(Q3);
e := a1*b3^2+2*b2*b3+2*b3^3;
b1 := b3 + a1; 
a2 := 2*b2+b1^2-2*a1*b1+a1^2;
c1 := 2*b1-a1;

a := 1+a1*t+a2*t^2;
b := e*(1+b1*t+b2*t^2);
c := e^2*(1+c1*t);

ai := [0,a,0,2*b*t^3,c*t^6];
ec := EllipticCurve(ai);
// unfortunately it is defined over Q(sqrt -3)
Qr<r> := QuadraticField(-3);
Qrsr<sr> := FunctionField(Qr);
ecsr := BaseChange(ec,hom<Q3t->Qrsr|hom<Q3->Qrsr|(-7+r)/2,1,1>,sr>);
// we cannot rescale to make the set of bad fibres rational.

// D15A2A1: start with I9 I1*, specialize
Qn<a1,a2,b1,b2,f> := FunctionField(Q,5);
Qnt<t> := FunctionField(Qn);
e := 8*(f-b2)^2*(2*f+b2)/27;
a3 := 4*(b2^2 - f^2)/3;
a := 1 + a1*t + a2*t^2 + a3*t^3;
b := e*(1 + b1*t + b2*t^2);
c := e^2*(1 + t);
ai := [0,a,0,2*b*t^4,c*t^8];
ec := EllipticCurve(ai);

Qn<a2,b1,b2,f> := FunctionField(Q,4);
Qnt<t> := FunctionField(Qn);
a1 := 2*b1-1;
e := 8*(f-b2)^2*(2*f+b2)/27;
a3 := 4*(b2^2 - f^2)/3;
a := 1 + a1*t + a2*t^2 + a3*t^3;
b := e*(1 + b1*t + b2*t^2);
c := e^2*(1 + t);
ai := [0,a,0,2*b*t^4,c*t^8];
ec := EllipticCurve(ai);

Qn<b1,b2,f> := FunctionField(Q,3);
Qnt<t> := FunctionField(Qn);
a2 := b1^2-2*b1+2*b2+1;
a1 := 2*b1-1;
e := 8*(f-b2)^2*(2*f+b2)/27;
a3 := 4*(b2^2 - f^2)/3;
a := 1 + a1*t + a2*t^2 + a3*t^3;
b := e*(1 + b1*t + b2*t^2);
c := e^2*(1 + t);
ai := [0,a,0,2*b*t^4,c*t^8];
ec := EllipticCurve(ai);

// now we put I2* at infinity
fac := Factorization(Numerator(LeadingCoefficient(Numerator(Discriminant(ec)))))[4,1];
A3 := Spec(Parent(fac));
q := Surface(A3,fac);
pq := ProjectiveClosure(fac);
P2 := ProjectiveSpace(Q,2);
to2 := map<pq->P2|[pq.1,pq.2-pq.3,pq.4]>;
Q2<a,b> := FunctionField(Q,2);
_,from2 := IsInvertible(to2);
gptim := from2(P2(Q2)![a,b,1]);
Q2t<t> := FunctionField(Q2);
ec := BaseChange(ec,hom<Qnt->Q2t|hom<Qn->Q2t|Eltseq(gptim)[1..3]>,t>);

// now promote I2* to I3*
Qs<s> := FunctionField(Q);
Qsu<u> := FunctionField(Qs);
ec := BaseChange(ec,hom<Q2t->Qsu|hom<Q2->Qsu|[s+1/2,s]>,u>);
// and now we make a repeated root
pol4 := Numerator(Qsu!Minimum(rep{x[1]: x in LocalInformation(ec1)|x[5] eq KodairaSymbol("I1")}));
d4 := Discriminant(pol4);
ec := BaseChange(ec1,hom<Qsu->Qs|hom<Qs->Qs|rep{x[1]: x in Roots(Numerator(d4))|x[2] eq 1}>,s>);
// now let's put it somewhere more reasonable
ec := BaseChange(ec0,hom<Qs->Qs|-s*5/3>);
// and twist.
ec2 := MinimalDegreeModel(QuadraticTwist(ec,s));
// got it.
// The I1 fibres are defined over Q(i).


// D13A5: same idea.
Qn<a1,a2,b1,b2,f> := FunctionField(Q,5);
Qnt<t> := FunctionField(Qn);
e := 8*(f-b2)^2*(2*f+b2)/27;
a3 := 4*(b2^2 - f^2)/3;
a := 1 + a1*t + a2*t^2 + a3*t^3;
b := e*(1 + b1*t + b2*t^2);
c := e^2*(1 + t);
ai := [0,a,0,2*b*t^4,c*t^8];
ec := EllipticCurve(ai);

// We already have I9, so it's just a matter of promoting I1* to I6*.
Qn<a1,b1,b2,f> := FunctionField(Q,4);
Qnt<t> := FunctionField(Qn);
a2 := 4/3*b1*b2 - 4/3*b1*f - 4/9*b2^2 + 8/9*b2*f - 4/9*f^2;
e := 8*(f-b2)^2*(2*f+b2)/27;
a3 := 4*(b2^2 - f^2)/3;
a := 1 + a1*t + a2*t^2 + a3*t^3;
b := e*(1 + b1*t + b2*t^2);
c := e^2*(1 + t);
ai := [0,a,0,2*b*t^4,c*t^8];
ec := EllipticCurve(ai);

Qn<b1,b2,f> := FunctionField(Q,3);
Qnt<t> := FunctionField(Qn);
a1 := (-1/3*b1^2*b2 + 1/3*b1^2*f + 4/9*b1*b2^2 - 8/9*b1*b2*f + 4/9*b1*f^2 - 4/27*b2^3 + 4/9*b2^2*f - 4/9*b2*f^2 + 4/3*b2*f + 4/27*f^3 - 4/3*f^2)/f;
a2 := 4/3*b1*b2 - 4/3*b1*f - 4/9*b2^2 + 8/9*b2*f - 4/9*f^2;
e := 8*(f-b2)^2*(2*f+b2)/27;
a3 := 4*(b2^2 - f^2)/3;
a := 1 + a1*t + a2*t^2 + a3*t^3;
b := e*(1 + b1*t + b2*t^2);
c := e^2*(1 + t);
ai := [0,a,0,2*b*t^4,c*t^8];
ec := EllipticCurve(ai);

A3 := AffineSpace(Q,3);
disc := Numerator(Discriminant(ec));
sch := Scheme(A3,[Numerator(Coefficient(disc,i)): i in [13..15]]);
// and we find the perfect component
ec := BaseChange(ec,hom<Qnt->Qs|hom<Qn->Qs|54/7,405/49,243/98>,s>);
// just have to twist
ec3 := MinimalDegreeModel(QuadraticTwist(ec,s));
// you can improve the model by getting rid of some factors of 3, but anyway
// unfortunately no good twists

// twist of the model in disc16.mag
ec4 := EllipticCurve([-3/4*s^8 + 3/2*s^7 + 15/4*s^6 + 36*s^5 - 369/4*s^4 - 153/2*s^3 + 657/4*s^2 + 63*s - 99,
    -1/4*s^12 + 3/4*s^11 + 3/2*s^10 - 38*s^9 + 189/2*s^8 + 225/2*s^7 - 288*s^6 - 513*s^5 + 2727/4*s^4 + 3411/4*s^3 - 1863/2*s^2 - 351*s + 378]);

X321 := EllipticCurve([-3*(s-1)^3*(s-4),-2*(s-1)^5*(s+8)]);
ec := BaseChange(X321,hom<Qs->Qs|4*(s^2-4*s+1)^3/(27*s*(s-4))>);
tw := MinimalDegreeModel(QuadraticTwist(ec,(s^2-4*s-1/2)*(s-2)));
// now we have to make the I6 fibres rational in order to twist there
Qr3<r3> := QuadraticField(3);
Qr3s3<sr3> := FunctionField(Qr3);
tw3 := ChangeRing(tw,Qr3s3);
P13 := ProjectiveSpace(Qr3,1);
tr := TranslationOfSimplex(P13,[P13(Qr3)|[1,0],[2-r3],[2+r3]]);
bc := BaseChange(tw3,hom<Qr3s3->Qr3s3|Evaluate(d[1]/d[2],[sr3,1])>) where d is DefiningPolynomials(tr);
// unfortunately this isn't such a good model, but we can bring it back
bcq := EllipticCurveWithjInvariant(Qs!jInvariant(bc));
ec5 := MinimalDegreeModel(QuadraticTwist(bcq,s*&*[Qs|Minimum(i[1]): i in LocalInformation(bcq)|i[5] eq KodairaSymbol("I0*")]));
// got it!

ec6 := Codomain(TwoIsogeny(Points(ec4,Roots(DivisionPolynomial(ec4,2))[1,1])[1]));

ec7 := Codomain(TwoIsogeny(Points(ec6,Roots(DivisionPolynomial(ec6,2))[3,1])[1]));

ec8 := EllipticCurve([-3*(9*s^8+48*s^7+48*s^4+64*s^6+128*s^3+16),-2*(3*s^4+8*s^3+8)*(9*s^8+48*s^7+48*s^4+64*s^6+128*s^3-8)]);

ec9 := EllipticCurve([-3*(-276*s^4+8*s^6+96*s^5+416*s^3-186*s^2+24*s-1)*(2*s^2+8*s-1),2*(11160*s^8+7392*s^10-15232*s^9-130176*s^7+220056*s^6-160416*s^5+54792*s^4+64*s^12+1536*s^11-9760*s^3+948*s^2-48*s+1)]);
// unfortunately no valid twists

ec10 := EllipticCurve([-3*(16+48*s^4-64*s^3+9*s^8-24*s^7+16*s^6),-2*(2+3*s^4-4*s^3)*(-32-96*s^4+128*s^3+9*s^8-24*s^7+16*s^6)]);

ecs_disc24 := [ec2,ec3,ec4,ec5,ec6,ec7,ec8,ec9,ec10];
